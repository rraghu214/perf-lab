<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>dev.crucible</groupId>
    <artifactId>perf-lab</artifactId>
    <version>0.1.0</version>
    <name>perf-lab</name>
    <description>PerfLab: Spring Boot target service for the Crucible performance agent</description>

    <properties>
        <java.version>21</java.version>

        <!-- The git sha this jar was built from, surfaced by GET /api/version.

             DESIGN.md 19.6: no measurement may begin until the target proves it
             is running the commit that was deployed. Measuring before a deploy
             lands attributes the OLD configuration's numbers to the NEW change,
             and the resulting figure is perfectly plausible, so nothing
             downstream catches it. This is not hypothetical: a full set of
             pool=20 measurements during the K1 cloud run was taken against a
             target that had never been restarted (docs/K1_CLOUD_RESULT.md 6).

             The deploy script passes the real value:
                 ./mvnw -B -Dperflab.commit=$(git rev-parse HEAD) package

             Left as "unknown" on an ordinary build, which /api/version reports
             as a null commit, and Crucible then refuses to measure. That is
             the intended failure: a build that cannot say what it is must not
             be measured, and guessing is the failure mode this field exists
             to close. -->
        <perflab.commit>unknown</perflab.commit>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- H2 stays the zero-config default so the app runs with no containers.
             Postgres is used under the `lab` profile (docker-compose), which is
             what the cloud box runs. Both drivers ship; the URL picks one. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- Writes META-INF/build-info.properties, which Spring Boot
                         binds to a BuildProperties bean. `commit` rides along as
                         an additional property, so the sha has one source rather
                         than a second copy kept in step by hand. -->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                        <configuration>
                            <additionalProperties>
                                <commit>${perflab.commit}</commit>
                            </additionalProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
